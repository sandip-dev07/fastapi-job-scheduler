# Application
APP_NAME=Job Scheduler API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Local development defaults. Docker Compose builds its own internal
# DATABASE_URL/REDIS_URL from the service names and POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://jobqueue:jobqueue@localhost:5432/jobqueue
REDIS_URL=redis://localhost:6379/0

# Retry defaults applied to new jobs
DEFAULT_MAX_RETRIES=3
DEFAULT_RETRY_BACKOFF_SECONDS=5
MAX_RETRY_BACKOFF_SECONDS=300

# Docker Compose settings
POSTGRES_DB=jobqueue
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=jobqueue
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
